#cloud-config

ssh_authorized_keys:
  - ${ssh_key}

package_update: true
packages:
  - curl
  - ca-certificates
  - qemu-guest-agent

write_files:
  - path: /etc/netplan/90-static.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          k3s-nic:
            match:
              macaddress: ${mac}
            addresses:
              - ${address}
            routes:
              - to: default
                via: ${gateway}
            nameservers:
              addresses: [${dns}]

  - path: /etc/rancher/k3s/config.yaml
    content: |
      token: ${token}
      tls-san: ${server_ip}

  - path: /usr/local/bin/install-k3s.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server ${taint}" sh -
      mkdir -p /home/ubuntu/.kube
      k3s kubectl config view --raw > /home/ubuntu/.kube/config
      sed -i "s|127.0.0.1|${server_ip}|" /home/ubuntu/.kube/config
      chown -R ubuntu:ubuntu /home/ubuntu/.kube
      chmod 600 /home/ubuntu/.kube/config

runcmd:
  - netplan apply
  - systemctl enable --now qemu-guest-agent
  - [bash, /usr/local/bin/install-k3s.sh]
