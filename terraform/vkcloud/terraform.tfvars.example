# Скопируй в terraform.tfvars и подставь свои значения.
# tfvars в .gitignore, здесь пароль, поэтому в репозиторий его класть нельзя.

# Два способа передать доступ, выбери один.

# Способ 1, через tfvars. Логин и id проекта лежат в панели VK Cloud
# на вкладке Terraform, там же кнопка выгрузки готового файла провайдера.
username   = "почта-от-аккаунта@example.com"
password   = "пароль"
project_id = "id-проекта"

# Способ 2, ничего здесь не заполнять, а экспортировать переменные в шелле.
# Имена именно такие, провайдер читает их сам, если аргументы не заданы.
#
#   export OS_USERNAME="почта-от-аккаунта@example.com"
#   export OS_PASSWORD="пароль"
#   export OS_PROJECT_ID="id-проекта"
#
# Остальное провайдер подставляет по умолчанию для VK Cloud:
# адрес авторизации https://msk.cloud.vk.ru/infra/identity/v3/,
# домен users, регион RegionOne. Менять их не нужно.

# Зона доступности, MS1 это Москва.
availability_zone = "MS1"

# Кому разрешено ходить на узел. Префикс обязателен.
# Узнать: curl -s https://ifconfig.me
allowed_cidrs = ["203.0.113.10/32"]
