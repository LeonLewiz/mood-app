# Скопируй в terraform.tfvars и заполни. Доступа здесь нет, он в окружении.

# ---------------------------------------------------------------------------
# Авторизация: только экспорт переменных, перед каждым запуском Terraform.
#
# Проще всего выгрузить OpenStack RC-файл в панели VK Cloud
# (имя пользователя в шапке, Настройки проекта) и подключить его:
#
#   source ~/vk-openstack-rc.sh
#
# Если экспортировать руками, то так:
#
#   export OS_AUTH_URL="https://msk.cloud.vk.ru/infra/identity/v3/"
#   export OS_USERNAME="логин-от-аккаунта"
#   export OS_PASSWORD="пароль"
#   export OS_PROJECT_ID="id-проекта"
#   export OS_USER_DOMAIN_NAME="users"
#   export OS_REGION_NAME="RegionOne"
#
# В VK Cloud доступ по API выключен по умолчанию. Пока он выключен, любой
# запрос с логином и паролем отклоняется, а Terraform показывает просто
# «Authentication failed». Включается в панели: Настройки проекта, вкладка
# Доступ по API, кнопка Активировать доступ по API.
# ---------------------------------------------------------------------------

# Зона доступности, MS1 это Москва.
availability_zone = "MS1"

# Кому разрешено ходить на узел. Префикс обязателен.
# Узнать: curl -s https://ifconfig.me
allowed_cidrs = ["203.0.113.10/32"]
